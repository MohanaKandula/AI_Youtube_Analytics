# TutorTrace Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the .env file to git repository.

# Server & Security
PORT=5000
FLASK_DEBUG=false
SECRET_KEY=generate-a-secure-random-256-bit-key
JWT_SECRET_KEY=generate-a-secure-jwt-secret-key
CORS_ALLOWED_ORIGINS=https://tutortrace.vercel.app,http://localhost:5173

# Frontend Environment Variables (Vercel / Local)
VITE_API_BASE_URL=https://tutortrace-backend.onrender.com
VITE_YOUTUBE_API_KEY=your_youtube_api_v3_key_here

# Database (PostgreSQL)
# For Cloud Deployments (Render / Railway / Supabase / Neon):
DATABASE_URL=postgresql://user:password@host:port/dbname
# For Local Deployments:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=youtube_analytics
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Redis Cache
# For Cloud Deployments (Upstash / Render Redis):
REDIS_URL=rediss://default:password@host:port
# For Local Deployments:
REDIS_HOST=localhost
REDIS_PORT=6379

# Google YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_v3_key_here

# OpenRouter / OpenAI (Chatbot AI)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Email / SMTP (Registration OTP & Password Reset)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
